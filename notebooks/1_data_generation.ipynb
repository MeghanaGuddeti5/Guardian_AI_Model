import pandas as pd
import numpy as np

np.random.seed(42)
n = 5000

typing_speed = np.random.normal(250, 40, n)
typing_variance = np.random.normal(35, 10, n)

data = {
    "user_id": np.random.randint(1, 1000, n),
    "amount": np.random.exponential(scale=2000, size=n),
    "hour": np.random.randint(0, 24, n),
    "typing_speed": typing_speed,
    "typing_variance": typing_variance,
    "device_angle": np.random.normal(45, 10, n),
    "session_time": np.random.normal(120, 30, n),
}

df = pd.DataFrame(data)

df["fraud"] = (
    (df["amount"] > 8000) |
    (df["typing_speed"] < 150) |
    (df["typing_variance"] < 15) |
    (df["hour"].isin([1, 2, 3, 4]))
).astype(int)

df.to_csv("../data/transactions.csv", index=False)

print("Saved data with columns:")
print(df.columns)


